---
// Not prerendered, on purpose. "/" is also the hosted app's shell on
// cloud.deepdoc.tech (src/pages/cloud/index.ts, reached through the hostname
// rewrite in src/middleware.ts). Cloudflare Pages serves a prerendered path as
// a static asset before any Function runs, so a static "/" would show this
// page on both domains. Docs and changelog have no such collision.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PixelStage from "../components/PixelStage.astro";
import { CLOUD, GITHUB } from "../lib/nav";

const phases = [
  { name: "Scan", note: "Parse the source. Find endpoints, jobs, models, integrations and OpenAPI specs.", cost: "No LLM" },
  { name: "Plan", note: "Cluster the call graph, then name and group the clusters into sections.", cost: "A few calls" },
  { name: "Generate", note: "Assemble evidence for each page, write it, validate it, repair it.", cost: "One call per page" },
  { name: "API reference", note: "Stage any OpenAPI spec as an interactive reference page.", cost: "No LLM" },
  { name: "Build", note: "Write the site, navigation, search and optional chatbot.", cost: "No LLM" },
];

const stacks = [
  ["Python", "Django · DRF · FastAPI · Falcon"],
  ["JavaScript / TypeScript", "Express · Fastify · NestJS"],
  ["PHP", "Laravel"],
  ["Go", "net/http and common routers"],
  ["Vue", "Components and symbols"],
  ["OpenAPI", "Imported as a reference"],
];
---

<Layout>
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-grid pixel-grid" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow reveal" style="--d:0">Open source · MIT · Not backed by YC</p>
        <h1 class="display hero-title reveal" style="--d:1">
          Documentation that keeps pace with your <span class="em-serif">codebase.</span>
        </h1>
        <p class="lede hero-lede reveal" style="--d:2">
          DeepDoc reads your repository and writes a docs site with a chatbot that cites real files,
          then regenerates only the pages your commits touch.
        </p>
        <div class="hero-cta reveal" style="--d:3">
          <a class="btn" href={CLOUD}>
            Generate docs for a repo
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <button class="btn secondary mono copy" type="button" data-copy="pip install deepdoc" aria-label="Copy install command">
            <span class="copy-text">pip install deepdoc</span>
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
          </button>
        </div>
        <p class="hero-meta faint reveal" style="--d:4">Python 3.10+ · Bring your own model · <a class="link" href={GITHUB} target="_blank" rel="noreferrer">View on GitHub</a></p>
      </div>
      <div class="wrap stage-wrap reveal" style="--d:5">
        <PixelStage />
      </div>
    </section>

    <!-- What it does -->
    <section class="block">
      <div class="wrap">
        <p class="eyebrow">What it does</p>
        <h2 class="h2 block-title">One command. A docs site your team won’t ignore.</h2>
        <div class="trio">
          <article>
            <span class="num mono">01</span>
            <h3>Organised the way readers look</h3>
            <p class="muted">Architecture, endpoints, integrations and schemas grouped by domain, not one noisy page per file.</p>
            <p class="proof mono">auth.py, middleware.ts <span>→</span> Auth &amp; Permissions</p>
          </article>
          <article>
            <span class="num mono">02</span>
            <h3>Answers that cite real files</h3>
            <p class="muted">An assistant ships with the site. Every answer points to a file path and line range in your source.</p>
            <p class="proof mono">billing/routes.py:41-88</p>
          </article>
          <article>
            <span class="num mono">03</span>
            <h3>Updates touch only what changed</h3>
            <p class="muted">Run <code class="inline-code">deepdoc update</code> after a commit and only the affected pages regenerate.</p>
            <p class="proof mono">3 files changed <span>→</span> 2 pages</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Pipeline -->
    <section class="block ruled">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Pipeline</p>
          <h2 class="h2 block-title">Five phases. No magic.</h2>
          <p class="muted side-note">
            Every page is grounded in scanned evidence, repaired into valid Markdown and checked for source
            coverage before the site builds. Only two phases spend tokens.
          </p>
          <a class="arrow-link" href="/docs/reference/how-it-works">
            How it works
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <ol class="phases">
          {phases.map((p, i) => (
            <li>
              <span class="mono faint">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <strong>{p.name}</strong>
                <span class="muted">{p.note}</span>
              </div>
              <em class="mono">{p.cost}</em>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Chat -->
    <section class="block ruled">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Ask your docs</p>
          <h2 class="h2 block-title">Evidence, not assertions.</h2>
          <p class="muted side-note">
            Retrieval runs over your source, symbols and docs. Where it finds no support it says so instead of guessing.
            Pick fast lookup or a deeper research pass per question.
          </p>
          <a class="arrow-link" href="/docs/chatbot">
            About the chatbot
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="frame chat" aria-label="Example chatbot conversation">
          <div class="frame-bar"><span class="frame-dot"></span><span class="frame-dot"></span><span class="frame-dot"></span><span class="frame-title">/ask</span></div>
          <div class="chat-body">
            <p class="bubble user">Where does billing verification happen?</p>
            <div class="bubble bot">
              Payment verification runs in the billing flow and is persisted through usage records.
              <span class="ref mono">billing/routes.py:41-88</span>
              <span class="ref mono">services/usage.py:12-57</span>
            </div>
            <p class="bubble user">How does the widget token flow work?</p>
            <div class="bubble bot">
              The widget fetches a short-lived token from <code class="inline-code">/api/widget-token</code> and attaches it to every chat request.
              <span class="ref mono">api/widget.ts:18-64</span>
            </div>
            <div class="modes mono"><span class="on">fast</span><span>deep research</span><span>code-first</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Two ways in -->
    <section class="block ruled">
      <div class="wrap">
        <p class="eyebrow">Get started</p>
        <h2 class="h2 block-title">Two ways in.</h2>
        <div class="ways">
          <article class="way">
            <h3>In the browser</h3>
            <p class="muted">Sign in with GitHub, pick a repository (private ones too) and get a docs site at a stable address. Private by default.</p>
            <a class="btn" href={CLOUD}>Open DeepDoc Cloud</a>
          </article>
          <article class="way">
            <h3>In your terminal</h3>
            <div class="frame term-frame">
              <pre class="term"><span class="p">$ </span>pip install deepdoc
<span class="p">$ </span>deepdoc init --provider anthropic
<span class="p">$ </span>export ANTHROPIC_API_KEY=sk-ant-...
<span class="p">$ </span>deepdoc generate
<span class="p">$ </span>deepdoc serve
<span class="o">  Docs → http://localhost:3000</span></pre>
            </div>
            <a class="arrow-link" href="/docs/quickstart">
              Read the quickstart
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- Works with -->
    <section class="block ruled">
      <div class="wrap">
        <p class="eyebrow">Works with</p>
        <ul class="stacks">
          {stacks.map(([name, detail]) => (
            <li><strong>{name}</strong><span class="faint">{detail}</span></li>
          ))}
        </ul>
        <p class="faint stack-note">
          Other languages parse but are not fully supported. Endpoint, runtime and call-graph analysis cover the stacks above.
        </p>
      </div>
    </section>

    <!-- Demo video -->
    <section class="block ruled">
      <div class="wrap">
        <div class="video-head">
          <div>
            <p class="eyebrow">See a real run</p>
            <h2 class="h2 block-title">Watch the pipeline run.</h2>
          </div>
          <span class="faint mono">41 sec · all five phases</span>
        </div>
        <div class="frame video-frame">
          <video
            id="demo-video"
            src="https://pub-8f896d606470418f9c3a4a670bf154c4.r2.dev/demo.mp4"
            controls
            muted
            preload="none"
            playsinline
            aria-label="Screen recording of deepdoc generate running all five pipeline phases against a repository, 41 seconds"
          >
            <track kind="captions" src="/demo-captions.vtt" srclang="en" label="English" />
          </video>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="closing">
      <div class="wrap closing-inner">
        <h2 class="h2">Your codebase already tells a story. <span class="em-serif">Let it.</span></h2>
        <div class="hero-cta">
          <a class="btn" href={CLOUD}>Generate docs for a repo</a>
          <a class="btn secondary" href="/docs">Read the docs</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; padding: 88px 0 72px; }
  .hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 70% 62% at 50% 0%, black 0%, transparent 72%);
    mask-image: radial-gradient(ellipse 70% 62% at 50% 0%, black 0%, transparent 72%);
  }
  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero-title { margin-top: 20px; max-width: 860px; font-size: clamp(2.5rem, 6.2vw, 4.75rem); }
  .hero-lede { margin-top: 22px; max-width: 580px; }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 32px; }
  .hero-meta { margin-top: 22px; font-size: 13px; }
  .stage-wrap { position: relative; margin-top: 56px; }
  .copy { gap: 10px; }
  .copy .check-icon { display: none; }
  .copy.is-copied .copy-icon { display: none; }
  .copy.is-copied .check-icon { display: block; }

  /* Blocks */
  .block { padding: 96px 0; }
  .block.ruled { border-top: 1px solid var(--line); }
  .block-title { margin-top: 14px; max-width: 640px; }
  .side-note { margin: 18px 0 24px; max-width: 420px; }
  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: start; }

  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 56px; border-top: 1px solid var(--line); }
  .trio article { padding: 28px 28px 0 0; }
  .trio article + article { padding-left: 28px; border-left: 1px solid var(--line); }
  .trio h3 { margin: 14px 0 8px; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
  .trio p.muted { font-size: 14.5px; }
  .num { font-size: 12px; color: var(--ink-faint); }
  .proof { margin-top: 20px; font-size: 12px; color: var(--ink-muted); }
  .proof span { color: var(--ink-faint); }

  .phases { border-top: 1px solid var(--line); }
  .phases li {
    display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 14px; align-items: baseline;
    padding: 18px 0; border-bottom: 1px solid var(--line);
  }
  .phases strong { display: block; font-size: 16px; font-weight: 600; letter-spacing: -0.015em; }
  .phases div span { display: block; margin-top: 3px; font-size: 14px; }
  .phases em { font-style: normal; font-size: 11.5px; color: var(--ink-faint); white-space: nowrap; }

  /* Chat demo */
  .chat-body { padding: 22px; display: flex; flex-direction: column; gap: 12px; }
  .bubble { max-width: 88%; padding: 11px 14px; border-radius: var(--r-md); font-size: 14px; line-height: 1.55; }
  .bubble.user { align-self: flex-end; background: var(--surface-high); color: var(--ink); }
  .bubble.bot { align-self: flex-start; border: 1px solid var(--line-strong); color: var(--ink-muted); }
  .ref {
    display: inline-block; margin: 8px 6px 0 0; padding: 2px 8px; border-radius: 999px;
    border: 1px solid var(--line-strong); background: var(--surface-raised);
    font-size: 11px; color: var(--ink);
  }
  .modes { display: flex; gap: 8px; margin-top: 6px; font-size: 11.5px; color: var(--ink-faint); }
  .modes span { padding: 3px 11px; border: 1px solid var(--line); border-radius: 999px; }
  .modes .on { color: var(--solid-ink); background: var(--solid); border-color: var(--solid); }

  /* Ways in */
  .ways { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 48px; }
  .way {
    display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 28px;
    border: 1px solid var(--line-strong); border-radius: var(--r-lg); background: var(--card);
    box-shadow: inset 0 1px 0 var(--edge);
  }
  .way h3 { font-size: 19px; font-weight: 600; letter-spacing: -0.02em; }
  .way .frame { width: 100%; box-shadow: none; background: var(--surface); }
  .way .term { padding: 14px 16px; font-size: 12.5px; }

  .stacks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 28px; border-top: 1px solid var(--line); }
  .stacks li { display: flex; flex-direction: column; gap: 2px; padding: 18px 16px 18px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .stacks strong { font-weight: 600; letter-spacing: -0.01em; }
  .stack-note { margin-top: 18px; font-size: 13px; max-width: 560px; }

  .video-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 32px; }
  .video-frame { aspect-ratio: 16 / 9; background: var(--surface-raised); }
  .video-frame video { width: 100%; height: 100%; object-fit: cover; }

  .closing { border-top: 1px solid var(--line); padding: 112px 0; }
  .closing-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 28px; }
  .closing .h2 { max-width: 560px; }

  @media (max-width: 860px) {
    .hero { padding: 56px 0 48px; }
    .block { padding: 64px 0; }
    .split { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .trio { grid-template-columns: minmax(0, 1fr); }
    .trio article, .trio article + article { padding: 24px 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .ways { grid-template-columns: minmax(0, 1fr); }
    .stacks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .closing { padding: 72px 0; }
  }
</style>

<script>
  // Copy-to-clipboard for the install command.
  document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.classList.add("is-copied");
        setTimeout(() => btn.classList.remove("is-copied"), 1600);
      } catch {}
    });
  });

  // Play the demo only while it is on screen.
  const video = document.getElementById("demo-video") as HTMLVideoElement | null;
  if (video && "IntersectionObserver" in window) {
    new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? video.play().catch(() => {}) : video.pause())),
      { threshold: 0.4 }
    ).observe(video);
  }
</script>
