                      <span class="text-xs text-[var(--color-ink-muted)]"> — {desc}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <!-- ── DATA MODELS ───────────────────────────────────────── -->
          <section id="data-models">
            <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-faint)]">
              06
            </div>
            <h2 class="mb-2 text-2xl font-semibold tracking-tight text-[var(--color-ink)] md:text-3xl">
              Core Data Models
            </h2>
            <p class="mb-8 text-base leading-relaxed text-[var(--color-ink-muted)]">
              The entire pipeline communicates through three dataclasses defined in
              <code class="inline-code">deepdoc/v2_models.py</code>. Understanding these is key to
              understanding how DeepDoc plans, generates, and tracks documentation.
            </p>

            <!-- DocBucket -->
            <div class="mb-6 overflow-hidden rounded-2xl border border-[var(--color-line)]">
              <div class="flex items-center justify-between border-b border-[var(--color-line)] px-5 py-3">
                <span class="font-mono text-sm font-semibold text-[var(--color-ink)]">DocBucket</span>
                <span class="font-mono text-xs text-[var(--color-ink-faint)]">deepdoc/v2_models.py</span>
              </div>
              <p class="px-5 pt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                The atomic planning unit. One bucket = one documentation page. The planner creates, assigns, and
                refines buckets; the generator consumes them. Every bucket must pass
                <code class="inline-code">validate_plan_contract()</code> before workers start.
              </p>
              <div class="terminal-block m-5 mt-4">
                <div class="terminal-header">
                  <div class="flex gap-1.5"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
                  <span class="terminal-title">python</span>
                </div>
                <pre class="terminal-body">@dataclass
class DocBucket:
    <span class="c"># Identity</span>
    bucket_type: str          <span class="c"># system | feature | endpoint | integration | database</span>
    title: str                <span class="c"># page title shown in nav</span>
    slug: str                 <span class="c"># URL slug, e.g. "checkout-flow"</span>
    section: str              <span class="c"># nav section grouping</span>
    description: str          <span class="c"># one-line description for planning context</span>

    <span class="c"># Ownership — what evidence goes into this page</span>
    owned_files: list[str]    <span class="c"># file paths relative to repo root</span>
    owned_symbols: list[str]  <span class="c"># "module.Class.method" qualified names</span>
    artifact_refs: list[str]  <span class="c"># config keys, env vars, OpenAPI ops</span>

    <span class="c"># Generation instructions</span>
    generation_hints: dict    <span class="c"># prompt_style, is_introduction_page, flow_id, flow_entrypoints</span>
    required_sections: list[str]
    required_diagrams: list[str]

    <span class="c"># Topology</span>
    depends_on: list[str]     <span class="c"># slugs this bucket depends on</span>
    parent_slug: str | None

    <span class="c"># Metadata</span>
    priority: int             <span class="c"># generation order within section</span>
    publication_tier: str     <span class="c"># core | advanced | deprecated</span>
    source_kind_summary: str  <span class="c"># summary of what kind of code is in owned_files</span></pre>
              </div>
            </div>

            <!-- DocPlan -->
            <div class="mb-6 overflow-hidden rounded-2xl border border-[var(--color-line)]">
              <div class="flex items-center justify-between border-b border-[var(--color-line)] px-5 py-3">
                <span class="font-mono text-sm font-semibold text-[var(--color-ink)]">DocPlan</span>
                <span class="font-mono text-xs text-[var(--color-ink-faint)]">deepdoc/v2_models.py</span>
              </div>
              <p class="px-5 pt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                The complete output of the planner. Must pass <code class="inline-code">validate_plan_contract()</code>:
                exactly one introduction bucket, unique slugs/output paths, and resolved non-duplicate nav entries.
              </p>
              <div class="terminal-block m-5 mt-4">
                <div class="terminal-header">
                  <div class="flex gap-1.5"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
                  <span class="terminal-title">python</span>
                </div>
                <pre class="terminal-body">@dataclass
class DocPlan:
    buckets: list[DocBucket]         <span class="c"># ordered list — generation order</span>
    nav_structure: dict[str, list]   <span class="c"># section → [slug, ...] for sidebar nav</span>
    skipped_files: list[str]         <span class="c"># intentionally excluded (tests, fixtures…)</span>
    orphaned_files: list[str]        <span class="c"># files not assigned to any bucket</span>
    classification: str              <span class="c"># repo type: "api_service" | "monolith" | …</span>
    integration_candidates: list[str]</pre>
              </div>
            </div>

            <!-- RepoScan -->
            <div class="overflow-hidden rounded-2xl border border-[var(--color-line)]">
              <div class="flex items-center justify-between border-b border-[var(--color-line)] px-5 py-3">
                <span class="font-mono text-sm font-semibold text-[var(--color-ink)]">RepoScan</span>
                <span class="font-mono text-xs text-[var(--color-ink-faint)]">deepdoc/v2_models.py</span>
              </div>
              <p class="px-5 pt-4 pb-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                The output of Phase 1. Carries all scanned signals: parsed files, endpoints, symbols,
                plus the call graph, topology map, and flow candidates that drive planning. Also tracks
                file content hashes for staleness detection and scan timings for performance telemetry.
              </p>
            </div>
          </section>

          <!-- ── CONFIGURATION ─────────────────────────────────────── -->
          <section id="configuration">
            <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-faint)]">
