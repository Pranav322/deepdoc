---
interface Props { title: string; href: string; description?: string }
const { title, href, description } = Astro.props;
---
<a class="card-link" href={href}>
  <span class="card-link-title">{title}
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </span>
  {description && <span class="card-link-desc">{description}</span>}
</a>
