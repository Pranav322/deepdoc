---
// NOT prerendered (unlike docs.astro/changelog.astro): this exact path (/)
// is also where the hosted app's shell lives (src/pages/cloud/index.ts),
// reached via src/middleware.ts rewriting cloud.deepdoc.tech requests.
// Cloudflare Pages serves a prerendered path as a static asset *before* the
// Function/middleware ever runs, so if this were prerendered, "/" would
// always serve the marketing homepage regardless of hostname. Rendering
// per-request (still deterministic, same output) lets middleware branch
// correctly. docs.astro/changelog.astro have no such collision and can stay
// static.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PipelineOrbit from "../components/PipelineOrbit.astro";
import BackgroundRippleEffect from "../components/BackgroundRippleEffect.astro";
import CodeToDocs from "../components/CodeToDocs.astro";

const features = [
  {
    num: "01",
    title: "Bucket-based generation",
    body: "Architecture, endpoints, integrations, and schemas planned as cohesive docs — not one noisy page per file. The planner classifies your repo, proposes buckets, assigns files and symbols to a final reader-first structure.",
  },
  {
    num: "02",
    title: "Evidence-grounded chatbot",
    body: "An embedded assistant ships with the docs site. Answers are hydrated from indexed source with exact file paths and line ranges, with fast lookup, deep research, and code-first modes.",
  },
  {
    num: "03",
    title: "Incremental updates",
    body: "`deepdoc update` diffs against the last synced commit and regenerates only affected buckets. Smart enough to do a targeted replan when new integrations or endpoints appear.",
  },
];

const pipeline = [
  { step: "Scan",     note: "Parse source. Detect endpoints, runtime surfaces, integrations, OpenAPI specs." },
  { step: "Plan",     note: "Multi-step LLM planner. Classify repo, propose buckets, assign files." },
  { step: "Generate", note: "Build evidence packs. LLM call per bucket. Python-side repair and grounding checks." },
  { step: "API Ref",      note: "Stage OpenAPI specs into a single MkDocs Swagger UI page when a spec exists." },
  { step: "Build",    note: "Write site scaffold, page tree, nav, search, and optional chatbot widget." },
];

const langs = ["Python", "TypeScript", "JavaScript", "Go", "PHP", "Vue", "OpenAPI"];

const chatMessages = [
  {
    role: "You",
    text: "Where does billing verification happen?",
    refs: [],
  },
  {
    role: "DeepDoc",
    text: "Payment verification is handled in the Razorpay billing flow, then persisted through the usage and project records.",
    refs: ["billing/routes.py:41-88", "services/usage.py:12-57"],
  },
];

---

<Layout>
  <Header />

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section
    id="hero-cursor-zone"
    class="relative overflow-hidden"
    style="border-bottom: 1px solid var(--color-line);"
  >
    <!-- Single calm halo behind the headline -->
    <div class="hero-halo" aria-hidden="true"></div>

    <BackgroundRippleEffect />

    <!-- Ambient hero blobs: blurred, screen-blended, drifting on their own
         infinite loops (no cursor-tracking — that was tried and rejected as
         "ugly", see git history). -->
    <div class="gradients-container" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-6 pt-16 pb-14 md:pt-24 md:pb-20">
      <div class="flex flex-col items-center text-center">

        <!-- Identity badge -->
        <div
          class="anim-fade-up mb-5 inline-flex items-center gap-2.5 rounded-full px-4 py-1.5"
          style="background: color-mix(in srgb, var(--color-accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent); font-family: var(--font-mono); font-size: 12px; color: var(--color-accent);"
        >
          <span
            class="h-2 w-2 rounded-full"
            style="background: var(--color-accent); box-shadow: 0 0 6px var(--color-accent);"
          ></span>
          <strong style="font-weight: 600;">Open source</strong>
          <span style="opacity: 0.5; margin: 0 1px;">·</span>
          in-site AI chat
        </div>

        <!-- Headline -->
        <h1
          class="anim-fade-up anim-delay-1 display"
          style="font-size: clamp(2.5rem, 5.2vw, 4.25rem); color: var(--color-ink); max-width: 960px;"
        >
          Turn any <span class="accent-italic">codebase</span> into docs<br class="hidden sm:inline" />
          your team will <span class="accent-italic">actually read.</span>
        </h1>

        <!-- Sub -->
        <p
          class="anim-fade-up anim-delay-2 mt-6 max-w-xl leading-relaxed"
          style="font-size: 1.0625rem; color: var(--color-ink-muted); font-family: var(--font-sans);"
        >
          Generate complete documentation from your repository — with an AI
          assistant that answers using your actual source code.
        </p>

        <!-- CTAs — two clearly distinct paths: self-host (open source) vs hosted (cloud) -->
        <div class="anim-fade-up anim-delay-3 mt-9 flex flex-col items-center gap-x-3 gap-y-6 sm:flex-row sm:items-start sm:justify-center">
            <!-- Path 1: self-host / open source -->
            <div class="flex flex-col items-center gap-2">
              <a
                href="#get-started"
                class="group flex h-11 items-center gap-2 rounded-lg px-5"
                style="border: 1px solid var(--color-accent); color: var(--color-accent); background: transparent; font-family: var(--font-sans); font-size: 14px; font-weight: 600; transition: background 0.15s; white-space: nowrap; text-decoration: none;"
                onmouseover="this.style.background='color-mix(in srgb, var(--color-accent) 12%, transparent)'"
                onmouseout="this.style.background='transparent'"
              >
                Run Locally with pip
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  style="opacity: 0.6;"
                ><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
              </a>
              <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--color-ink-faint);">
                self-host &middot; open source
              </span>
            </div>

            <!-- Path 2: hosted / cloud -->
            <div class="flex flex-col items-center gap-2">
              <button
                type="button"
                id="try-free-btn"
                class="flex h-11 items-center gap-2 rounded-lg px-5"
                style="border: none; color: var(--color-surface); background: var(--color-accent); font-family: var(--font-sans); font-size: 14px; font-weight: 600; transition: opacity 0.15s; white-space: nowrap; cursor: pointer;"
                onmouseover="this.style.opacity='0.88'"
                onmouseout="this.style.opacity='1'"
              >
                Try the Demo &rarr;
              </button>
              <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--color-ink-faint);">
                hosted &middot; nothing to install
              </span>
            </div>

          </div>

          <p
            class="anim-fade-up anim-delay-4 mt-8"
            style="font-size: 12px; color: var(--color-ink-faint); font-family: var(--font-sans);"
          >
            Python 3.10+ &middot; MIT license &middot; Any LLM provider &middot;
            <a
              href="https://github.com/tss-pranavkumar/deepdoc"
              target="_blank"
              rel="noreferrer"
              style="color: var(--color-ink-faint); text-decoration: underline; text-underline-offset: 2px; transition: color 0.15s;"
              onmouseover="this.style.color='var(--color-ink)'"
              onmouseout="this.style.color='var(--color-ink-faint)'"
            >View on GitHub</a>
          </p>
        </div>

        <!-- Full-width product window -->
        <div class="anim-fade-up anim-delay-4 hero-stage">
          <div class="hero-glow" aria-hidden="true"></div>
          <div class="hero-window">
            <div class="proof-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="proof-url">deepdoc.local/docs/contextly-platform-overview</span>
            </div>
            <div class="hero-image-wrap">
              <img
                src="/proof-docs-dark.png"
                alt="Generated DeepDoc documentation site for the Contextly platform, showing structured navigation and source-grounded content"
                class="proof-image-dark"
                loading="eager"
                decoding="async"
              />
              <img
                src="/proof-docs.png"
                alt="Generated DeepDoc documentation site for the Contextly platform, showing structured navigation and source-grounded content"
                class="proof-image-light"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>

          <div class="chat-proof-card">
            <div class="chat-proof-header">
              <span class="chat-pulse"></span>
              DeepDoc Chatbot
            </div>
            {
              chatMessages.map((message) => (
                <div class={`chat-bubble ${message.role === "You" ? "user" : "assistant"}`}>
                  <div class="chat-role">{message.role}</div>
                  <div>{message.text}</div>
                  {message.refs ? (
                    <div class="chat-refs">
                      {message.refs.map((ref) => (
                        <span>{ref}</span>
                      ))}
                    </div>
                  ) : null}
                </div>
              ))
            }
          </div>
        </div>
    </div>
  </section>

  <!-- ── Language strip ──────────────────────────────────────────── -->
  <section
    class="border-b border-[var(--color-line)]"
    style="border-bottom: 1px solid var(--color-line);"
  >
    <div class="mx-auto max-w-6xl px-6 py-4 flex items-center gap-3 flex-wrap">
      <span
        style="font-size: 11px; font-family: var(--font-mono); color: var(--color-ink-faint); text-transform: uppercase; letter-spacing: 0.12em; white-space: nowrap;"
      >
        Works with
      </span>
      <span
        style="width: 1px; height: 12px; background: var(--color-line-strong);"
        aria-hidden="true"
      ></span>
      {
        langs.map((l) => (
          <span
            style="font-size: 12px; font-family: var(--font-sans); color: var(--color-ink-muted);"
          >
            {l}
          </span>
        ))
      }
    </div>
  </section>

  <!-- ── Demo video ──────────────────────────────────────────────── -->
  <section class="section-raised">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-end justify-between gap-4 flex-wrap">
        <div>
          <div
            style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-ink-faint); margin-bottom: 10px;"
          >
            See it in action
          </div>
          <h2
            class="display"
            style="font-size: clamp(1.75rem, 4vw, 2.75rem); color: var(--color-ink);"
          >
            Watch the pipeline run.
          </h2>
        </div>
        <span style="font-size: 12px; color: var(--color-ink-faint); font-family: var(--font-sans);">
          41 sec · all five phases
        </span>
      </div>

      <div
        class="overflow-hidden rounded-2xl"
        style="border: 1px solid var(--color-line-strong); box-shadow: 0 24px 72px rgba(0,0,0,0.55); background: #0a0a0e; aspect-ratio: 16 / 9; position: relative;"
      >
        <video
          id="demo-video"
          src="https://pub-8f896d606470418f9c3a4a670bf154c4.r2.dev/demo.mp4"
          controls
          muted
          preload="metadata"
          playsinline
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;"
        ></video>
        <!-- Shown only if video fails to load -->
        <noscript>
          <div
            class="flex items-center justify-center"
            style="position: absolute; inset: 0; color: var(--color-ink-faint); font-family: var(--font-sans); font-size: 13px; text-align: center; padding: 24px;"
          >
            Run <code style="margin: 0 6px; font-family: var(--font-mono); color: var(--color-accent);">deepdoc/video → npm run render</code> to generate the demo video.
          </div>
        </noscript>
      </div>
    </div>
  </section>

  <!-- Demo video auto-plays (muted, per browser autoplay policy) once it's
       actually visible, and pauses the moment it scrolls out of view —
       no reason to keep decoding/playing an offscreen video. Muted stays
       the default even after re-entering the viewport; the native controls
       let a visitor unmute/pause manually without fighting the observer. -->
  <script>
    (function () {
      const video = document.getElementById('demo-video');
      if (!video || !('IntersectionObserver' in window)) return;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.4 },
      );
      observer.observe(video);
    })();
  </script>

  <!-- ── Features ────────────────────────────────────────────────── -->
  <section style="border-bottom: 1px solid var(--color-line);">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-10 max-w-xl">
        <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-ink-faint); margin-bottom: 10px;">
          What it does
        </div>
        <h2 class="display" style="font-size: clamp(1.75rem, 4vw, 2.75rem); color: var(--color-ink);">
          One command. A docs site<br />your team won't ignore.
        </h2>
      </div>

      <div class="features-bento">

        <!-- 01: Organized docs (wide) -->
        <div class="feat-card feat-card-wide">
          <div class="feat-num">01</div>
          <h3 class="feat-title">Your docs stay organized</h3>
          <p class="feat-body">
            Architecture, endpoints, integrations, and schemas — grouped the way
            readers actually look for them, not one noisy page per file.
          </p>
          <div class="feat-visual">
            <div class="feat-visual-row">
              <span class="feat-visual-files">auth.py, middleware.ts</span>
              <span class="feat-visual-arrow">→</span>
              <span class="feat-visual-bucket">Auth &amp; Permissions</span>
            </div>
            <div class="feat-visual-row">
              <span class="feat-visual-files">billing/routes.py, usage.py</span>
              <span class="feat-visual-arrow">→</span>
              <span class="feat-visual-bucket">Billing &amp; Usage</span>
            </div>
            <div class="feat-visual-row">
              <span class="feat-visual-files">api/webhooks.ts, stripe.py</span>
              <span class="feat-visual-arrow">→</span>
              <span class="feat-visual-bucket">Integrations</span>
            </div>
            <div class="feat-visual-row">
              <span class="feat-visual-files">db/models.py, migrations/*.sql</span>
              <span class="feat-visual-arrow">→</span>
              <span class="feat-visual-bucket">Data &amp; Schema</span>
            </div>
          </div>
        </div>

        <!-- 02: AI answers cite real files (tall) -->
        <div class="feat-card feat-card-tall">
          <div class="feat-num">02</div>
          <h3 class="feat-title">AI answers cite real files</h3>
          <p class="feat-body">
            Ask your docs anything. Every answer points to exact file paths and
            line ranges from your actual source — not hallucinations. Follow-ups
            keep the whole thread in-page.
          </p>
          <div class="feat-chat">
            <div class="feat-chat-bubble user">
              Where does billing verification happen?
            </div>
            <div class="feat-chat-bubble bot">
              Payment verification runs in the Razorpay billing flow, persisted through usage records.
              <div class="feat-chat-ref">↗ billing/routes.py:41-88</div>
              <div class="feat-chat-ref">↗ services/usage.py:12-57</div>
            </div>
            <div class="feat-chat-bubble user">
              How does the widget token flow work?
            </div>
            <div class="feat-chat-bubble bot">
              The widget fetches a short-lived token from <code style="font-size:11px; opacity:0.8;">/api/widget-token</code>, then attaches it to every chat request.
              <div class="feat-chat-ref">↗ api/widget.ts:18-64</div>
            </div>
            <div class="feat-chat-bubble bot feat-chat-typing" aria-hidden="true">
              <span class="feat-typing-dot"></span>
              <span class="feat-typing-dot"></span>
              <span class="feat-typing-dot"></span>
            </div>
          </div>
          <div class="feat-modes">
            <span class="feat-mode active">fast lookup</span>
            <span class="feat-mode">deep research</span>
            <span class="feat-mode">code-first</span>
          </div>
        </div>

        <!-- 03: Updates regenerate only what changed (wide) -->
        <div class="feat-card feat-card-wide">
          <div class="feat-num">03</div>
          <h3 class="feat-title">Updates regenerate only what changed</h3>
          <p class="feat-body">
            Push a commit, run <code style="font-family: var(--font-mono); font-size: 12px; opacity: 0.85;">deepdoc update</code>, and only the affected pages
            regenerate. Your docs keep up without a full rebuild.
          </p>
          <div class="feat-diff">
            <div class="feat-diff-header">deepdoc update — 3 files changed</div>
            <div class="feat-diff-row">
              <span class="feat-diff-dot changed"></span>
              <span class="feat-diff-label">billing/routes.py</span>
              <span class="feat-diff-tag regen">regenerate</span>
            </div>
            <div class="feat-diff-row">
              <span class="feat-diff-dot changed"></span>
              <span class="feat-diff-label">services/stripe.py</span>
              <span class="feat-diff-tag regen">regenerate</span>
            </div>
            <div class="feat-diff-row">
              <span class="feat-diff-dot unchanged"></span>
              <span class="feat-diff-label">db/models.py</span>
              <span class="feat-diff-tag skip">skip</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Pipeline ────────────────────────────────────────────────── -->
  <section style="border-bottom: 1px solid var(--color-line);">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-10 max-w-xl">
        <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-ink-faint); margin-bottom: 10px;">
          Pipeline
        </div>
        <h2 class="display" style="font-size: clamp(1.75rem, 4vw, 2.75rem); color: var(--color-ink);">
          Five phases. No magic.
        </h2>
        <p style="margin-top: 14px; font-family: var(--font-sans); font-size: 14px; line-height: 1.7; color: var(--color-ink-muted); max-width: 480px;">
          Every page is grounded in scanned evidence, repaired into valid Markdown,
          and checked for source coverage before the site builds.
        </p>
      </div>

      <PipelineOrbit />
    </div>
  </section>

  <!-- ── Getting started ─────────────────────────────────────────── -->
  <section id="get-started" class="section-raised" style="scroll-margin-top: 76px;">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
        <!-- Left: copy -->
        <div>
          <div
            style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-ink-faint); margin-bottom: 10px;"
          >
            Getting started
          </div>
          <h2
            class="display"
            style="font-size: clamp(1.75rem, 4vw, 2.75rem); color: var(--color-ink);"
          >
            Three commands.
          </h2>
          <p
            style="margin-top: 14px; font-family: var(--font-sans); font-size: 14px; line-height: 1.75; color: var(--color-ink-muted); max-width: 420px;"
          >
            Initialize against any Python, JavaScript/TypeScript, Go, PHP, or Vue
            codebase. Set one API key. Generate. The chatbot inherits the same key
