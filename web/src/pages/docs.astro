          <!-- ── CHATBOT ───────────────────────────────────────────── -->
          <section id="chatbot">
            <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-faint)]">
              11
            </div>
            <h2 class="mb-2 text-2xl font-semibold tracking-tight text-[var(--color-ink)] md:text-3xl">
              Chatbot
            </h2>
            <p class="mb-8 text-base leading-relaxed text-[var(--color-ink-muted)]">
              An opt-in RAG chatbot that answers questions about your codebase with
              <strong class="text-[var(--color-ink)]">evidence-first</strong> responses. Embeddings run
              <strong class="text-[var(--color-ink)]">100% locally</strong> via fastembed — no extra API
              key or paid embedding service required. Three independent model surfaces let you
              mix providers: one for doc generation, one for chat answers, one for embeddings.
            </p>

            <!-- Enable -->
            <div class="mb-8 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-raised)]/40 p-6">
              <h3 class="mb-4 text-base font-semibold text-[var(--color-ink)]">Enable the chatbot</h3>
              <div class="terminal-block">
                <div class="terminal-header">
                  <div class="flex gap-1.5"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
                  <span class="terminal-title">bash</span>
                </div>
                <pre class="terminal-body"><span class="c"># Enable during init</span>
deepdoc init --provider anthropic --with-chatbot

<span class="c"># Or add to .deepdoc.yaml manually</span>
chatbot:
  enabled: true

<span class="c"># The chatbot model can differ from the doc generation model</span>
chatbot:
  enabled: true
  answer:
    provider: openai
    model: gpt-4o-mini            <span class="c"># fast + cheap for chat</span>
  embeddings:
    backend: fastembed
    model: nomic-ai/nomic-embed-text-v1.5  <span class="c"># ~300 MB, downloaded once</span></pre>
              </div>
            </div>

            <!-- Three modes -->
            <h3 class="mb-4 text-base font-semibold text-[var(--color-ink)]">Query modes</h3>
            <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {[
                { mode: "/query", label: "Fast", color: "var(--color-accent)", desc: "Single-pass FAISS + SQLite FTS hybrid retrieval. Best for quick look-ups. Returns in ~1s. Source evidence is hydrated from the content-addressed SQLite archive." },
                { mode: "/deep", label: "Deep Research", color: "#A5B4FC", desc: "Multi-step ReAct loop (max 5 iterations per sub-question). Agent tools: semantic search, read_file (source archive), regex grep. Streams via SSE with synthesis_token_callback." },
                { mode: "/code-deep", label: "Code-first", color: "#86EFAC", desc: "Strict source-first mode with trace and file inventory. Missing exact evidence is reported as a gap, not hallucinated. Implementation claims must be grounded in source/config evidence." },
              ].map(({ mode, label, color, desc }) => (
                <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-raised)]/40 p-5">
                  <div class="mb-1 flex items-center gap-2">
                    <span class="h-1.5 w-1.5 rounded-full" style={`background:${color}`}></span>
                    <span class="font-mono text-xs font-semibold" style={`color:${color}`}>{label}</span>
                  </div>
                  <code class="mb-3 block font-mono text-sm text-[var(--color-ink)]">{mode}</code>
                  <p class="text-xs leading-relaxed text-[var(--color-ink-muted)]">{desc}</p>
                </div>
              ))}
            </div>

            <!-- Retrieval architecture -->
            <h3 class="mb-4 text-base font-semibold text-[var(--color-ink)]">Retrieval architecture</h3>
            <div class="overflow-hidden rounded-2xl border border-[var(--color-line)]">
              <div class="border-b border-[var(--color-line)] px-5 py-3">
                <span class="font-mono text-xs text-[var(--color-ink-faint)]">retrieval pipeline</span>
              </div>
              <pre class="overflow-x-auto p-5 font-mono text-xs leading-6 text-[var(--color-ink-muted)]">Query
  │
  ├─ <span class="text-[var(--color-accent)]">FAISS vector search</span>    (nomic-embed-text-v1.5, 768-dim)
  │    └─ top-K semantic candidates
  │
  ├─ <span style="color:#A5B4FC">SQLite FTS5 search</span>     (BM25 lexical)
  │    └─ top-K keyword candidates
  │
  ├─ <span style="color:#86EFAC">Symbol + relationship chunks</span>
  │    └─ function signatures, class hierarchies, call relationships
  │
  ├─ <span style="color:#67E8F9">Adjacent window stitching</span>
  │    └─ chunks adjacent to strong hits for context continuity
  │
  ├─ Optional: <span style="color:#FDE68A">LLM rerank</span>    (cross-encoder scoring)
  │
  └─ <span class="text-[var(--color-ink)]">Evidence hydration</span>     → evidence[] + references[]
       │
       ├─ Source archive lookup (content-addressed SQLite)
       ├─ Exact file:line snippet extraction
       └─ Answer generation with evidence-first prompt
            ├─ Citation dedup by (path, start_line, end_line)
            ├─ SSE streaming response (timeout=30 + ping keepalive)
            └─ Validation: rejects invented paths, unknown evidence IDs</pre>
            </div>

            <!-- Evidence contract -->
            <div class="mt-6 rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-accent-dim)]/30 p-6">
              <div class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-accent)]">Evidence-First Contract</div>
              <p class="text-sm leading-relaxed text-[var(--color-ink-muted)]">
                All chatbot endpoints share one response contract: <code class="inline-code">evidence[]</code> is the
                canonical source of right-pane code/config snippets (each with file_path, start_line, end_line, snippet).
                <code class="inline-code">references[]</code> contains generated docs or repo-authored docs — read-next links,
                not implementation proof. The answer validator rejects invented source paths, <code class="inline-code">line unknown</code>,
                and docs used as implementation proof. If a retry still fails, the backend returns a conservative answer with diagnostics.
              </p>
            </div>

            <!-- Index storage -->
            <div class="mt-6 overflow-hidden rounded-2xl border border-[var(--color-line)]">
              <div class="border-b border-[var(--color-line)] px-5 py-3">
                <span class="font-mono text-xs text-[var(--color-ink-faint)]">index storage (under .deepdoc/)</span>
              </div>
              <div class="divide-y divide-[var(--color-line)]">
                {[
                  { path: ".deepdoc/chatbot/faiss.index", desc: "FAISS flat L2 index with invalid-embedding filter (score ≤ -0.5). Rebuilt on each generate run." },
                  { path: ".deepdoc/chatbot/fts.db", desc: "SQLite FTS5 database for BM25 lexical search." },
                  { path: ".deepdoc/chatbot/chunks.json", desc: "Chunk metadata: text, file, line range, type (code, symbol, relationship, docs)." },
                  { path: ".deepdoc/chatbot/source_archive.sqlite3", desc: "Content-addressed SQLite source archive. Canonical evidence hydration source. Legacy gzip archives migrate automatically." },
                  { path: ".deepdoc/chatbot/symbol_index.json", desc: "Symbol name → file:line map for fast symbol look-up in code-deep mode." },
                ].map(({ path, desc }) => (
                  <div class="flex flex-col gap-1 px-5 py-3 sm:flex-row sm:items-start sm:gap-6">
                    <code class="w-full shrink-0 font-mono text-xs text-[var(--color-accent)] sm:w-64">{path}</code>
                    <span class="text-sm text-[var(--color-ink-muted)]">{desc}</span>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <!-- ── INCREMENTAL UPDATES ───────────────────────────────── -->
          <section id="updates">
            <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-faint)]">
              12
            </div>
            <h2 class="mb-2 text-2xl font-semibold tracking-tight text-[var(--color-ink)] md:text-3xl">
              Incremental Updates
