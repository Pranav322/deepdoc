            <p class="mb-6 text-base leading-relaxed text-[var(--color-ink-muted)]">
              <code class="inline-code">.deepdoc.yaml</code> lives in your repo root.
              <code class="inline-code">deepdoc init</code> writes sensible defaults; you only need to set
              <code class="inline-code">llm.provider</code> and your API key env var.
              All other settings — context windows, token limits, model capabilities — are auto-resolved
              from LiteLLM model metadata.
            </p>

            <!-- minimal example -->
            <div class="mb-8 terminal-block">
              <div class="terminal-header">
                <div class="flex gap-1.5"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
                <span class="terminal-title">.deepdoc.yaml</span>
              </div>
              <pre class="terminal-body">project_name: My API
description: "Internal API service for orders and fulfilment"

llm:
  provider: anthropic           <span class="c"># required</span>
  model: claude-sonnet-4-20250514  <span class="c"># optional — uses provider default if omitted</span>
  api_key_env: ANTHROPIC_API_KEY
  rate_limits:
    max_concurrency: 6          <span class="c"># simultaneous LLM calls</span>
    requests_per_minute: 60
    adaptive_backoff: true      <span class="c"># share 429 cooldown across workers</span>

generation_mode: feature_buckets  <span class="c"># topology-driven pipeline (default)</span>
max_parallel_workers: 6
output_dir: docs
site_dir: site

<span class="c"># Optional chatbot — inherits llm.* for answer generation</span>
chatbot:
  enabled: true
  embeddings:
    backend: fastembed           <span class="c"># 100% local — no API key needed</span>
    model: nomic-ai/nomic-embed-text-v1.5</pre>
