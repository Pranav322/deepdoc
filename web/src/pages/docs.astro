---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const nav = [
  { id: "quick-start",    label: "Quick Start" },
  { id: "architecture",   label: "Architecture" },
  { id: "pipeline",       label: "Five-Phase Pipeline" },
  { id: "topology",       label: "Topology Planner" },
  { id: "evidence",       label: "Evidence System" },
  { id: "data-models",    label: "Data Models" },
  { id: "configuration",  label: "Configuration" },
  { id: "cli",            label: "CLI Reference" },
  { id: "bucket-types",   label: "Bucket Types" },
  { id: "languages",      label: "Supported Languages" },
  { id: "chatbot",        label: "Chatbot" },
  { id: "updates",        label: "Incremental Updates" },
  { id: "deployment",     label: "Deployment" },
  { id: "modules",        label: "Module Reference" },
  { id: "vscode",         label: "VS Code Extension" },
];

const pipeline = [
  {
    step: "Scan",
    num: "01",
    color: "var(--color-accent)",
    desc: "Walk the entire repository without any LLM calls. Tree-sitter parses every supported source file to extract functions, classes, and symbols. Framework-aware route detectors identify HTTP endpoints across Django, FastAPI, Express, NestJS, Fastify, Laravel, Go net/http, and Falcon. A function-level call graph is built to map caller→callee relationships. Runtime surfaces (Celery tasks, async workers, schedulers), third-party integrations, database schemas (SQL migrations, Knex, Django ORM, GraphQL schemas), config artifacts, and OpenAPI specs are all detected and cataloged.",
    output: "RepoScan — call graph, topology map, flow candidates, endpoints, symbols, routes, integrations, artifacts, database schemas",
  },
  {
    step: "Plan",
    num: "02",
    color: "#67E8F9",
    desc: "Topology-driven bucket planner using 3 sequential LLM calls. First, build_topology_map() uses the pre-built call graph to compute cohesive domain clusters via BFS + Jaccard-based merging — no LLM involved. Then: Step 1 (Classify) — send topology clusters to the LLM to name each cluster and assign domain sections. Step 2 (Propose) — build DocBucket objects from named clusters with file ownership. Step 3 (Assign + Refine) — heuristic ownership assignment, flow hint attachment, bucket decomposition for oversized groups, singleton consolidation, and nav shaping that orders sections by topology depth.",
    output: "DocPlan — ordered bucket list with nav structure, publication tiers, flow hints, dependency graph",
  },
  {
    step: "Generate",
    num: "03",
    color: "#A5B4FC",
    desc: "For each bucket: assemble a tiered evidence pack (Tier 0: full source of owned files, Tier 0.5: owned symbol bodies for partially-owned files, Tier 1: full source of supporting files, Tier 2: compressed evidence cards for overflow). Evidence includes flow context for buckets with execution paths, endpoint metadata, OpenAPI excerpts, and cross-bucket dependency summaries. The LLM receives a page-type-specific prompt and generates CommonMark with Mermaid diagrams. Python-side repair runs immediately — fence fixup, Mermaid normalization, link rewriting, frontmatter repair. A validation pass checks section coverage, file grounding, route accuracy, and symbol hallucination. On failure, the LLM is reprompted with quality feedback (up to 3 retries). After all pages: a cross-bucket consistency pass detects missing cross-links and injects \"See also\" callouts.",
    output: "Markdown pages on disk, per-page quality status, generation quality log, consistency warnings",
  },
  {
    step: "API Ref",
    num: "04",
    color: "#C4B5FD",
    desc: "When OpenAPI/Swagger specs are detected during the scan phase, they are staged and rewritten with clean base paths. A single interactive API reference page is generated with embedded spec rendering. The pipeline supports both JSON and YAML specs, auto-detects spec versions (OpenAPI 3.x and Swagger 2.0), and handles multi-spec repos by combining them into a unified reference.",
    output: "docs/api.md — interactive API reference from staged OpenAPI specs",
  },
  {
    step: "Build",
    num: "05",
    color: "#86EFAC",
    desc: "Write the Next.js + Fumadocs site scaffold into site/. The builder copies the shell template (React layout, routing, Mermaid rendering, syntax highlighting with Shiki, built-in search), writes deepdoc.config.json (nav tree, brand colors, chatbot URL, project name), generates app/globals.css with brand CSS vars, and places all generated Markdown pages into the docs/ content directory. The remark/rehype pipeline handles plain CommonMark safely — no MDX compile step, so LLM-generated content can never crash a build. When chatbot is enabled, the chatbot widget component and /ask page are included.",
    output: "site/ — a production-ready Next.js + Fumadocs static site with built-in search, Mermaid, and syntax highlighting",
  },
];

const bucketTypes = [
  { type: "system", color: "var(--color-accent)", desc: "Top-level architecture, setup guides, auth flows, observability dashboards, and ops runbooks. Every repo gets at least one system bucket. Covers infrastructure concerns that cut across features — deployment configs, environment setup, monitoring, and developer onboarding." },
  { type: "feature", color: "#A5B4FC", desc: "Business-logic workflows: checkout, refunds, onboarding, notifications, user management. Scoped to how engineers think about the domain, not how files are laid out. Feature buckets own the files that implement a coherent user-facing capability and include Mermaid sequence diagrams for key flows." },
  { type: "endpoint", color: "#67E8F9", desc: "Endpoint-family API docs. One bucket per logical resource (e.g. all /orders/* routes). Enriched with scanned route metadata including HTTP methods, URL patterns, middleware chains, and authentication requirements. Automatically groups related routes even when spread across multiple files." },
  { type: "endpoint_ref", color: "#8B5CF6", desc: "Single-endpoint reference page backed by an OpenAPI spec. Rendered as part of the interactive API reference page with request/response schemas, parameter descriptions, and example payloads from the spec." },
  { type: "integration", color: "#86EFAC", desc: "Third-party system docs: payment gateways (Stripe, Braintree), delivery providers, webhook consumers, external APIs, message queues. Auto-detected from import patterns, SDK client instantiations, and configuration references. Includes credential management and error handling documentation." },
  { type: "database", color: "#FDE68A", desc: "Schema and data-layer docs. Grouped by model family when a repo has many models; a single overview page for smaller schemas. Covers ORM model definitions, SQL migrations, relationship mappings, and query patterns. Includes ER diagrams generated as Mermaid." },
];

const cliCommands = [
  {
    cmd: "deepdoc init",
    flags: [
      { flag: "--provider", val: "anthropic | openai | gemini | azure | ollama", desc: "LLM provider. Sets llm.provider in .deepdoc.yaml." },
      { flag: "--model", val: "string", desc: "Override the default model for the chosen provider." },
      { flag: "--with-chatbot", val: "flag", desc: "Enable the chatbot module. Adds chatbot config with sensible defaults (local fastembed embeddings, inherited LLM)." },
      { flag: "--output-dir", val: "path", desc: "Where generated Markdown pages land. Default: docs/" },
      { flag: "--name", val: "string", desc: "Project name used in site title. Default: directory name." },
    ],
    desc: "Scaffold a .deepdoc.yaml config file in the current directory. Safe to re-run — only missing keys are added. Writes automatic completion capability defaults for the chosen provider.",
  },
  {
    cmd: "deepdoc generate",
    flags: [
      { flag: "--force", val: "flag", desc: "Full refresh — regenerate all pages even if not stale. Cleans up pages that no longer belong in the new plan." },
      { flag: "--clean --yes", val: "flag", desc: "Delete output dir + .deepdoc/ state, then rebuild from scratch." },
      { flag: "--deploy", val: "flag", desc: "Generate + build and export the static site in one command." },
      { flag: "--batch-size", val: "int", desc: "Pages per batch before rate-limit pause. Default: 10." },
      { flag: "--include", val: "glob", desc: "Glob patterns to include (repeatable). Default: all files." },
      { flag: "--exclude", val: "glob", desc: "Additional glob patterns to exclude (repeatable)." },
    ],
    desc: "Run the full five-phase pipeline: scan → plan → generate → API ref → build. On success prints per-phase timings and a page-quality summary. Refuses to run if docs already exist unless --force or --clean is used.",
  },
  {
    cmd: "deepdoc update",
    flags: [
      { flag: "--since", val: "git-ref", desc: "Compare against this ref instead of the stored sync baseline." },
      { flag: "--replan", val: "flag", desc: "Force a full replan even if the changed file set is small." },
      { flag: "--deploy", val: "flag", desc: "Deploy after a fully successful update." },
    ],
    desc: "Incremental update. Diffs the repo against the last synced commit and chooses a strategy: incremental (regenerate stale pages only) or targeted replan (new endpoints/integrations detected). Appends changelog entries and rebuilds nav.",
  },
  {
    cmd: "deepdoc serve",
    flags: [
      { flag: "--port", val: "int", desc: "HTTP port for the Next.js dev server. Default: 3000." },
    ],
    desc: "Preview the generated docs locally. Runs next dev inside site/ with live reload. Auto-starts the chatbot backend when enabled. Requires Node.js ≥18.",
  },
  {
    cmd: "deepdoc deploy",
    flags: [],
    desc: "Build and export the Next.js + Fumadocs site. Runs next build inside site/ and writes static HTML to site/out/. Checks generation quality and refuses to deploy when pages are invalid or stub. Deploy the output to Vercel, Netlify, GitHub Pages, or any static host.",
  },
  {
    cmd: "deepdoc status",
    flags: [],
    desc: "Show how much documentation has been generated, which buckets are stale, and overall generation health. Quick health check without opening the site.",
  },
  {
    cmd: "deepdoc performance",
    flags: [],
    desc: "Show the latest pipeline timings, LLM token usage, retries, and I/O counters. Reads from .deepdoc/performance/runs.jsonl. Compares with the previous run when available.",
  },
  {
    cmd: "deepdoc config show | set",
    flags: [
      { flag: "show", val: "", desc: "Print all current config values." },
      { flag: "set", val: "key value", desc: "Update a config value. Supports dotted keys like llm.model." },
    ],
    desc: "View or update .deepdoc.yaml without editing YAML manually. Type inference handles booleans, numbers, and strings automatically.",
  },
];

const configKeys = [
  { key: "project_name",         dflt: "(repo dir name)",   desc: "Human-readable project name used in site title and nav header." },
  { key: "description",          dflt: '""',                desc: "One-line summary shown in hero and meta description." },
  { key: "output_dir",           dflt: '"docs"',            desc: "Where generated Markdown pages are written." },
  { key: "site_dir",             dflt: '"site"',            desc: "Where the generated Next.js + Fumadocs site shell lives." },
  { key: "generation_mode",      dflt: '"feature_buckets"', desc: 'v2 topology-driven bucket pipeline (default and recommended).' },
  { key: "max_pages",            dflt: "0",                 desc: "Cap on total pages generated. 0 = unlimited." },
  { key: "max_parallel_workers", dflt: "6",                 desc: "Concurrent LLM calls during generate phase. Bounded by rate_limits.max_concurrency." },
  { key: "llm.provider",         dflt: "(required)",        desc: "LLM provider: anthropic, openai, gemini, azure, ollama, or any LiteLLM alias." },
  { key: "llm.model",            dflt: "(provider default)",desc: "Model name. Passed directly to LiteLLM. Use provider prefix for non-Anthropic (e.g. azure/gpt-4.1)." },
  { key: "llm.api_key_env",      dflt: "auto-detected",     desc: "Env var name holding the API key. Inferred from provider if omitted." },
  { key: "llm.temperature",      dflt: "0.2",               desc: "Generation temperature. Lower = more deterministic output." },
  { key: "llm.base_model",       dflt: "null",              desc: "Canonical LiteLLM model name for custom/Azure deployment aliases." },
  { key: "llm.context_window_tokens", dflt: "null",         desc: "Model context window — resolved from LiteLLM metadata. Set for unknown deployments." },
  { key: "llm.rate_limits.max_concurrency", dflt: "6",      desc: "Maximum simultaneous doc-generation model requests." },
  { key: "llm.rate_limits.requests_per_minute", dflt: "60", desc: "Rolling request limit for the documentation model." },
  { key: "llm.rate_limits.tokens_per_minute", dflt: "250000", desc: "Rolling estimated input-token limit." },
  { key: "llm.rate_limits.adaptive_backoff", dflt: "true",  desc: "Share provider 429/Retry-After cooldown across workers." },
  { key: "chatbot.enabled",      dflt: "false",             desc: "Enable chatbot indexing and the /ask route in the built site." },
  { key: "chatbot.answer.provider", dflt: "(inherits llm)", desc: "Separate provider for chatbot answer calls. Inherits llm.* if empty." },
  { key: "chatbot.embeddings.backend", dflt: '"fastembed"',desc: "Embedding backend. fastembed runs 100% locally — no API key." },
  { key: "chatbot.embeddings.model", dflt: "nomic-embed-text-v1.5", desc: "Local embedding model (~300 MB, downloaded once on first run)." },
  { key: "giant_file_lines",     dflt: "2000",              desc: "Files above this threshold get LLM-based feature clustering into symbol groups." },
  { key: "source_context_budget", dflt: "200000",           desc: "Max chars of raw source per evidence pack before overflow files become compressed cards." },
  { key: "consistency_pass",     dflt: "true",              desc: "Run cross-bucket consistency pass after generation to inject 'See also' cross-links." },
  { key: "scan.max_workers",     dflt: "8",                 desc: "Bounded local workers for source reads, parsing, and per-file endpoint detection." },
];

const modules = [
  {
    path: "deepdoc/cli.py",
    role: "CLI entry-point",
    exports: ["init", "generate", "update", "serve", "deploy", "status", "performance", "config", "benchmark", "clean"],
    note: "Click commands with Rich output. Orchestrates all user-facing workflows. CLI-facing failures raise click.ClickException for clean error messages.",
  },
  {
    path: "deepdoc/pipeline_v2.py",
    role: "Pipeline orchestration",
    exports: ["PipelineV2", "_build_site()", "_record_changelog()", "_spec_base_path()", "_write_spec()"],
    note: "End-to-end orchestration driving all five phases. _build_site() must be called after _record_changelog() for correct nav. Manages OpenAPI spec rewriting and chatbot indexing.",
  },
  {
    path: "deepdoc/planner/engine.py",
    role: "Planner orchestration",
    exports: ["plan_docs()", "scan_repo()"],
    note: "Repo-scan entrypoint with deterministic bounded source workers and serial repo-level route resolution. Orchestrates the multi-step LLM planner: classify → propose → assign → refine.",
  },
  {
    path: "deepdoc/planner/topology.py",
    role: "Domain clustering",
    exports: ["build_topology_map()", "TopologyCluster"],
    note: "Pre-computes cohesive domain clusters from the call graph via BFS + Jaccard-based merging (threshold 0.40). No LLM involved. Feeds the classify step with named clusters instead of a compressed file tree.",
  },
  {
    path: "deepdoc/planner/heuristics.py",
    role: "Planning API",
    exports: ["_merge_plan()", "_build_heuristic_assignment()", "_partition_topology_assignment()", "_llm_step()"],
    note: "Public planning API. Tests mock at this path. ASSIGN preassigns files with exactly one candidate and matching topology; everything else goes to LLM inventory.",
  },
  {
    path: "deepdoc/planner/flow_candidates.py",
    role: "Execution path tracing",
    exports: ["FlowCandidate", "EntryPoint", "build_flow_candidates()"],
    note: "Traces endpoint families, runtime tasks, and schedulers through the call graph to identify execution flows. Flow hints are attached to domain buckets.",
  },
  {
    path: "deepdoc/generator/generation.py",
    role: "Page generation engine",
    exports: ["BucketGenerationEngine", "_call_with_retry()"],
    note: "Batched parallel generation with persistent bounded ThreadPoolExecutor. _call_with_retry() accepts failure_prefix for quality-feedback reprompting. Non-transient LLM errors raise immediately.",
  },
  {
    path: "deepdoc/generator/evidence.py",
    role: "Evidence assembly",
    exports: ["EvidenceAssembler", "AssembledEvidence"],
    note: "Builds tiered evidence packs: Tier 0 (full source), Tier 0.5 (owned symbol bodies), Tier 1 (supporting files), Tier 2 (compressed cards). Token-fitted with deterministic category order and line-boundary trimming.",
  },
  {
    path: "deepdoc/generator/consistency.py",
    role: "Cross-bucket consistency",
    exports: ["CrossBucketConsistencyPass"],
    note: "Post-generation LLM call that detects cross-link gaps between independently generated pages and injects 'See also' callouts. Runs after generate_all(), skips gracefully on failure.",
  },
  {
    path: "deepdoc/generator/validation.py",
    role: "Page quality validation",
    exports: ["PageValidator"],
    note: "Checks section coverage, file grounding, route accuracy, runtime/config/integration grounding, hallucinated paths and symbols, and flow grounding. Most checks are warning-only.",
  },
  {
    path: "deepdoc/generator/post_processors.py",
    role: "Markdown repair pipeline",
    exports: ["fix_mermaid_diagrams", "repair_unbalanced_code_fences", "normalize_html_code_blocks", "fix_frontmatter_description", "repair_internal_doc_links"],
    note: "Framework-neutral Markdown repair. repair_internal_doc_links is the single owner for validating /slug links against the page tree. No MDX/JSX escaping — the remark/rehype pipeline handles plain CommonMark safely.",
  },
  {
    path: "deepdoc/chatbot/",
    role: "RAG chatbot service",
    exports: ["ChatbotQueryService", "ChatbotIndexer", "DeepResearcher", "create_fastapi_app()"],
    note: "Three query modes: fast (single-pass FAISS), deep (agentic ReAct loop with search/read_file/grep tools), code-deep (strict source-first). Hybrid retrieval: FAISS + SQLite FTS + symbol chunks + relationship chunks.",
  },
  {
    path: "deepdoc/site/builder/",
    role: "Site scaffold generation",
    exports: ["build_next_from_plan()"],
    note: "Canonical site builder: copies the Next.js + Fumadocs shell template, writes deepdoc.config.json (nav, brand colors, chatbot URL), and generates brand CSS vars. Content is read at build time via a remark/rehype pipeline.",
  },
  {
    path: "deepdoc/call_graph.py",
    role: "Function-level call graph",
    exports: ["CallGraph", "CALL_KIND_LOCAL", "CALL_KIND_CELERY", "CALL_KIND_SIGNAL"],
    note: "Function-level call extraction for Python (Django/Falcon/DRF) and JS/TS (Express/Node). Powers topology clustering, flow candidate detection, and dependency mapping.",
  },
  {
    path: "deepdoc/smart_update_v2.py",
    role: "Incremental update engine",
    exports: ["SmartUpdater", "ChangeSet", "UpdateRunResult"],
    note: "Diff-based update strategy: incremental (stale pages only) or targeted replan (new endpoints/integrations). _handle_deleted_files cleans orphaned buckets. Scoped scans filter before reads for efficiency.",
  },
  {
    path: "deepdoc/persistence_v2.py",
    role: "State persistence",
    exports: ["load_ledger()", "save_ledger()", "load_sync_state()", "save_sync_state()"],
    note: "All state under .deepdoc/: plan, ledger (per-page quality + timestamp), sync state (last-generated commit hash), changelog, engine fingerprint, and scan cache.",
  },
];
---

<Layout
  title="Docs — DeepDoc"
  description="Full engineering reference for DeepDoc — architecture, topology-driven planner, evidence system, CLI, chatbot, and deployment."
>
  <Header />

  <!-- ── Two-column layout ───────────────────────────────────────── -->
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="flex gap-12 lg:gap-16">

      <!-- Sidebar -->
      <aside class="hidden w-52 shrink-0 lg:block">
        <nav class="sticky top-20 flex flex-col gap-0.5" id="docs-nav" aria-label="Page sections">
          {nav.map((item) => (
            <a
              href={`#${item.id}`}
              class="docs-nav-link rounded-md px-2.5 py-1.5 text-sm text-[var(--color-ink-faint)] transition-colors hover:text-[var(--color-ink)]"
              data-section={item.id}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Main content -->
      <main class="min-w-0 flex-1">
        <div class="flex flex-col gap-20">

          <!-- ── QUICK START ───────────────────────────────────────── -->
          <section id="quick-start">
            <div class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-faint)]">
              01
            </div>
            <h2 class="mb-2 text-2xl font-semibold tracking-tight text-[var(--color-ink)] md:text-3xl">
              Quick Start
            </h2>
            <p class="mb-8 text-base leading-relaxed text-[var(--color-ink-muted)]">
              Three commands to go from any supported codebase to a live documentation site with
              built-in search, Mermaid diagrams, and an optional AI-powered chatbot.
            </p>

            <!-- Step cards -->
            <div class="flex flex-col gap-6">

              <!-- Step 1 -->
              <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-raised)]/50 p-6">
                <div class="mb-4 flex items-center gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-dim)] font-mono text-xs font-semibold text-[var(--color-accent)]">1</span>
                  <h3 class="text-base font-semibold text-[var(--color-ink)]">Install the package</h3>
                </div>
                <div class="terminal-block">
                  <div class="terminal-header">
                    <div class="flex gap-1.5"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
                    <span class="terminal-title">bash</span>
                  </div>
                  <pre class="terminal-body"><span class="c"># Python 3.10+ required</span>
pip install deepdoc

<span class="c"># With chatbot dependencies (FAISS, FastAPI, fastembed)</span>
pip install "deepdoc[chatbot]"</pre>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                  The base install pulls in LiteLLM (100+ provider support), GitPython, tree-sitter (Python, JS, TS, Go, PHP parsers),
                  Click, Rich, PyYAML, and Jinja2. The <code class="inline-code">[chatbot]</code> extra adds faiss-cpu, fastapi,
                  uvicorn, httpx, and fastembed for fully local embeddings — no external embedding API needed.
                </p>
              </div>

              <!-- Step 2 -->
              <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-raised)]/50 p-6">
                <div class="mb-4 flex items-center gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-dim)] font-mono text-xs font-semibold text-[var(--color-accent)]">2</span>
                  <h3 class="text-base font-semibold text-[var(--color-ink)]">Initialise against your repo</h3>
                </div>
                <div class="terminal-block">
                  <div class="terminal-header">
                    <div class="flex gap-1.5"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
                    <span class="terminal-title">bash</span>
                  </div>
                  <pre class="terminal-body"><span class="c"># cd into your target codebase first</span>
cd /path/to/your-repo

<span class="c"># Initialize — writes .deepdoc.yaml with sensible defaults</span>
deepdoc init --provider anthropic

<span class="c"># Add --with-chatbot to enable the /ask Q&amp;A interface</span>
deepdoc init --provider openai --with-chatbot

<span class="c"># Set your API key (matches llm.api_key_env in .deepdoc.yaml)</span>
export ANTHROPIC_API_KEY=sk-ant-...</pre>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                  <code class="inline-code">init</code> is safe to re-run — it only adds keys that are missing. The generated
                  <code class="inline-code">.deepdoc.yaml</code> lives in your repo root and should be committed. It auto-detects
                  completion capabilities for the chosen provider so you don't need to configure context windows or token limits.
                </p>
              </div>

              <!-- Step 3 -->
              <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-raised)]/50 p-6">
                <div class="mb-4 flex items-center gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-dim)] font-mono text-xs font-semibold text-[var(--color-accent)]">3</span>
                  <h3 class="text-base font-semibold text-[var(--color-ink)]">Generate and preview</h3>
                </div>
                <div class="terminal-block">
                  <div class="terminal-header">
                    <div class="flex gap-1.5"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
                    <span class="terminal-title">bash</span>
                  </div>
                  <pre class="terminal-body"><span class="c"># Full pipeline — scan, plan, generate, build</span>
deepdoc generate

<span class="acc">✓</span> Scan complete        — 312 files · 47 endpoints · 8 integrations
<span class="acc">✓</span> Plan complete        — 34 buckets across 6 sections
<span class="acc">✓</span> Generate complete    — 34 pages · 2 Markdown fixes applied
<span class="acc">✓</span> Consistency pass     — 12 cross-link callouts injected
<span class="acc">✓</span> Chatbot index built  — 1,247 chunks · 4.2 MB FAISS index
<span class="acc">✓</span> Site scaffold written → site/

  Phase timings:  scan 4s · plan 18s · generate 72s · build 3s

<span class="c"># Preview locally (Node.js ≥18 required for Next.js dev server)</span>
deepdoc serve

  Docs   → http://localhost:3000
  Chat   → http://localhost:3000/ask</pre>
                </div>

                <!-- What just happened callout -->
                <div class="mt-5 rounded-xl border border-[var(--color-line-strong)] bg-[var(--color-accent-dim)]/30 p-4">
                  <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent)]">What just happened</div>
                  <p class="text-sm leading-relaxed text-[var(--color-ink-muted)]">
                    DeepDoc walked your codebase with tree-sitter, built a function-level call graph, clustered related
                    files into topology-driven documentation buckets, generated rich CommonMark pages with Mermaid
                    diagrams, ran a cross-bucket consistency pass to inject "See also" links, and scaffolded
                    a production-ready Next.js + Fumadocs site with built-in search, syntax highlighting, and
                    an optional AI chatbot — all from a single command.
