---
/**
 * The hero demo, and the whole product in one picture.
 *
 * Left is a repo: code as dim pixel runs, scrolling slowly, and you can draw
 * on it with the pointer. Right is its documentation: every source line is
 * summarised into a tidy, left-aligned line, with headings where a block of
 * code starts. Hover a documentation line and the source it came from lights
 * up with a file and line range, which is what DeepDoc's answers do for real.
 *
 * Pure canvas, no dependencies. Colour comes from the page's ink token so it
 * follows the light/dark switch.
 */
---

<div class="stage-shell">
<figure class="stage frame" aria-label="Interactive demo: code on the left becomes organised documentation on the right">
  <div class="stage-labels" aria-hidden="true">
    <span>your repo</span>
    <span>your docs</span>
  </div>
  <div class="stage-field pixel-grid">
    <canvas id="pixel-stage" aria-hidden="true"></canvas>
  </div>
  <figcaption class="sr-only">
    Code on the left scrolls by. Each block of code is summarised on the right as a heading and short lines. Moving the
    pointer over the left side draws pixels; moving it over a line on the right shows which source lines it came from.
  </figcaption>
</figure>
<p class="stage-hint" id="stage-hint" aria-hidden="true">
  <span class="stage-hint-key">Draw</span> on the code. <span class="stage-hint-key">Hover</span> a doc line to see its source.
</p>
</div>

<style>
  .stage { padding: 0; }
  .stage-labels {
    position: absolute; z-index: 2; top: 0; left: 0; right: 0;
    display: grid; grid-template-columns: 1fr 1fr; pointer-events: none;
    padding: 14px 18px 0;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .stage-labels span:last-child { padding-left: 14px; }
  .stage-field { position: relative; height: 392px; cursor: crosshair; touch-action: pan-y; }
  #pixel-stage { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--ink); }
  .stage-hint {
    margin-top: 16px; text-align: center; font-size: 13px; color: var(--ink-muted);
    transition: opacity 0.6s var(--ease);
  }
  .stage-hint.is-gone { opacity: 0.35; }
  .stage-hint-key {
    display: inline-block; padding: 1px 7px; margin-right: 2px; border-radius: 5px;
    border: 1px solid var(--line-strong); background: var(--card);
    font-family: var(--font-mono); font-size: 11px; color: var(--ink);
  }
  @media (max-width: 640px) {
    .stage-field { height: 340px; }
    .stage-hint { font-size: 11.5px; padding: 0 12px; }
  }
</style>

<script>
  const canvas = document.getElementById("pixel-stage") as HTMLCanvasElement | null;
  const hint = document.getElementById("stage-hint");
  if (canvas) boot(canvas, hint);

  function boot(canvas: HTMLCanvasElement, hint: HTMLElement | null) {
    const ctx = canvas.getContext("2d")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const TOP = 3; // rows kept clear for the labels
    const PATHS = [
      "api/billing/routes.py", "services/usage.py", "auth/middleware.ts", "db/models.py",
      "workers/sync.go", "handlers/webhook.php", "core/planner.py", "api/orders.ts",
    ];

    let CELL = 14, cols = 0, rows = 0, L = 0, R = 0, dpr = 1, w = 0, h = 0;
    let rgb = "236, 234, 227";

    // Source: a scrolling buffer of code lines, each a boolean row.
    let seed = 7;
    const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
    let sinceBlank = 0;
    function makeLine(width: number): boolean[] {
      const line = new Array(width).fill(false);
      sinceBlank++;
      if (sinceBlank > 4 + Math.floor(rnd() * 5)) { sinceBlank = 0; return line; }
      let x = [0, 0, 2, 2, 4][Math.floor(rnd() * 5)];
      const max = width - 1 - Math.floor(rnd() * Math.max(2, width * 0.4));
      while (x < max) {
        const run = 1 + Math.floor(rnd() * 4);
        for (let i = 0; i < run && x < max; i++) line[x++] = true;
        x += 1 + Math.floor(rnd() * 3);
      }
      return line;
    }

    let code: boolean[][] = [];
    let ink: Float32Array[] = [];
    let doc: Float32Array[] = [];
    let hoverRow = -1;
    let drew = false;

    function layout() {
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      CELL = w < 520 ? 12 : 14;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.floor(w / CELL);
      rows = Math.floor(h / CELL);
      L = Math.floor((cols - 2) / 2);
      R = cols - L - 2;
      // Preserve what exists where possible; otherwise rebuild.
      sinceBlank = 0;
      code = Array.from({ length: rows }, (_, y) => (y < TOP ? new Array(L).fill(false) : makeLine(L)));
      ink = Array.from({ length: rows }, () => new Float32Array(L));
      doc = Array.from({ length: rows }, () => new Float32Array(R));
    }

    function readColour() {
      const m = getComputedStyle(canvas).color.match(/[\d.]+/g);
      if (m) rgb = `${m[0]}, ${m[1]}, ${m[2]}`;
    }

    function rowCount(y: number) {
      let n = 0;
      for (let x = 0; x < L; x++) if (code[y][x] || ink[y][x] > 0.25) n++;
      return n;
    }

    function step() {
      // Decay what the visitor drew.
      for (let y = 0; y < rows; y++) {
        const r = ink[y];
        for (let x = 0; x < L; x++) if (r[x] > 0.002) r[x] *= 0.986;
      }
      // Doc targets from source rows, eased so edits settle rather than snap.
      const counts: number[] = [];
      for (let y = 0; y < rows; y++) counts.push(y < TOP ? 0 : rowCount(y));
      for (let y = 0; y < rows; y++) {
        const n = counts[y];
        const heading = n > 0 && (y === TOP || counts[y - 1] === 0);
        const len = n === 0 ? 0 : heading ? Math.min(R - 2, Math.max(3, Math.round(n * 0.55))) : Math.min(R - 1, Math.max(2, Math.round(n * 0.9)));
        const level = heading ? 0.95 : 0.5;
        const r = doc[y];
        for (let x = 0; x < R; x++) {
          const target = x < len ? level : 0;
          r[x] += (target - r[x]) * 0.18;
          if (r[x] < 0.004) r[x] = 0;
        }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      const pad = 1.5, s = CELL - 3;
      for (let y = TOP; y < rows; y++) {
        const hot = y === hoverRow;
        const src = code[y], inkRow = ink[y], docRow = doc[y];
        if (hot) {
          ctx.fillStyle = `rgba(${rgb}, 0.07)`;
          ctx.fillRect(0, y * CELL, cols * CELL, CELL);
        }
        for (let x = 0; x < L; x++) {
          const a = Math.max(src[x] ? (hot ? 0.9 : 0.26) : 0, inkRow[x] * 0.95);
          if (a > 0.01) { ctx.fillStyle = `rgba(${rgb}, ${a})`; ctx.fillRect(x * CELL + pad, y * CELL + pad, s, s); }
        }
        const ox = (L + 2) * CELL;
        for (let x = 0; x < R; x++) {
          const a = docRow[x];
          if (a > 0.01) { ctx.fillStyle = `rgba(${rgb}, ${hot ? Math.min(1, a + 0.35) : a})`; ctx.fillRect(ox + x * CELL + pad, y * CELL + pad, s, s); }
        }
      }
      // Divider: a dotted column between the two halves.
      ctx.fillStyle = `rgba(${rgb}, 0.16)`;
      for (let y = TOP; y < rows; y += 2) ctx.fillRect(L * CELL + CELL - 1, y * CELL + pad, 2, s);
      // Evidence label, drawn on the hovered row.
      if (hoverRow >= TOP) {
        const f = PATHS[(hoverRow * 5) % PATHS.length];
        const a = 12 + hoverRow * 3, label = `${f}:${a}-${a + 4}`;
        ctx.font = "500 11px 'JetBrains Mono', ui-monospace, monospace";
        const tw = ctx.measureText(label).width + 16, lx = w - tw - 10, ly = hoverRow * CELL - 4;
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue("--card") || "#131312";
        ctx.fillRect(lx, ly, tw, 20);
        ctx.strokeStyle = `rgba(${rgb}, 0.35)`;
        ctx.lineWidth = 1;
        ctx.strokeRect(lx + 0.5, ly + 0.5, tw - 1, 19);
        ctx.fillStyle = `rgba(${rgb}, 0.95)`;
        ctx.textBaseline = "middle";
        ctx.fillText(label, lx + 8, ly + 10.5);
      }
    }

    // Scrolling source.
    let lastScroll = 0;
    function scroll(now: number) {
      if (reduced || now - lastScroll < 1500) return;
      lastScroll = now;
      code.splice(TOP, 1);
      code.push(makeLine(L));
      ink.splice(TOP, 1); ink.push(new Float32Array(L));
    }

    let raf = 0, visible = false;
    function frame(now: number) {
      scroll(now);
      step();
      draw();
      raf = visible ? requestAnimationFrame(frame) : 0;
    }

    // Pointer: draw on the left half, inspect on the right.
    function cellAt(e: PointerEvent) {
      const r = canvas.getBoundingClientRect();
      return { cx: Math.floor((e.clientX - r.left) / CELL), cy: Math.floor((e.clientY - r.top) / CELL) };
    }
    canvas.addEventListener("pointermove", (e) => {
      const { cx, cy } = cellAt(e);
      if (cx < L) {
        hoverRow = -1;
        for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) {
          if (Math.abs(dx) + Math.abs(dy) > 1) continue;
          const x = cx + dx, y = cy + dy;
          if (y >= TOP && y < rows && x >= 0 && x < L) ink[y][x] = 1;
        }
        if (!drew) { drew = true; hint?.classList.add("is-gone"); }
      } else if (cx >= L + 2 && cy >= TOP && cy < rows && rowCount(cy) > 0) {
        hoverRow = cy;
        if (!drew) { drew = true; hint?.classList.add("is-gone"); }
      } else hoverRow = -1;
      if (!raf) raf = requestAnimationFrame(frame);
    });
    canvas.addEventListener("pointerleave", () => { hoverRow = -1; });

    new ResizeObserver(() => { layout(); draw(); }).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible && !raf) raf = requestAnimationFrame(frame);
    }).observe(canvas);
    const onTheme = () => { readColour(); draw(); };
    document.addEventListener("dd-theme", onTheme);
    new MutationObserver(onTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    readColour();
    layout();
    // Settle the doc side before the first paint so it does not build up from nothing.
    for (let i = 0; i < 40; i++) step();
    draw();
  }
</script>
