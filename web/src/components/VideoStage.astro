---
/**
 * The demo video in a window. It sits on the hero's paintable pixel grid
 * (PixelField), so this component is only the frame and its caption. The
 * video draws its own windows, so the frame here has no title bar.
 * The frame tilts upright as it scrolls into view (see the motion script in
 * index.astro), which is why it lives inside a perspective wrapper.
 */
// Rendered from deepdoc/video (npm run build, then the ffmpeg step in its
// README section of AGENTS.md) and served from this site.
const VIDEO = "/demo.mp4";
const POSTER = "/demo-poster.jpg";
---

<div class="vstage">
  <div class="frame vstage-frame" id="demo-frame">
    <div class="vstage-video">
      <video
        id="demo-video"
        src={VIDEO}
        poster={POSTER}
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        aria-label="A real deepdoc generate run on the youtube-notes repository, followed by the documentation site it produced. 42 seconds, no narration."
      >
        <track kind="captions" src="/demo-captions.vtt" srclang="en" label="English" />
      </video>
    </div>
  </div>
  <p class="vstage-note mono">A real run on Pranav322/youtube-notes · 6m 12s, shown in 42 seconds</p>
</div>

<style>
  .vstage { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 24px; perspective: 1600px; }
  .vstage-frame { background: #0B0B0C; transform-origin: 50% 100%; will-change: transform; }
  .vstage-video { aspect-ratio: 16 / 9; background: #0B0B0C; }
  .vstage-video video { width: 100%; height: 100%; object-fit: cover; }
  .vstage-note { margin-top: 20px; text-align: center; font-size: 12px; color: var(--ink-faint); }
  @media (max-width: 640px) { .vstage { padding: 0 16px; } }
</style>

<script>
  // Play the recording only while it is on screen.
  const video = document.getElementById("demo-video") as HTMLVideoElement | null;
  if (video && "IntersectionObserver" in window) {
    new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? video.play().catch(() => {}) : video.pause())),
      { threshold: 0.35 }
    ).observe(video);
  }
</script>
