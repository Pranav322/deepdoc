---
import Logo from "./Logo.astro";
import { CLOUD, headerLinks } from "../lib/nav";

interface Props {
  /** Docs pages use the full width so the sidebar can sit against the edge. */
  wide?: boolean;
}
const { wide = false } = Astro.props;
const path = Astro.url.pathname;
---

<header class:list={["site-header", wide && "is-wide"]}>
  <div class:list={["site-header-inner", !wide && "wrap", wide && "wide-pad"]}>
    <a href="/" class="brand-link" aria-label="DeepDoc home"><Logo size={21} /></a>

    <nav class="site-nav" aria-label="Primary">
      {
        headerLinks.map((item) => {
          const current = !item.external && (path === item.href || path.startsWith(item.href + "/"));
          return (
            <a
              href={item.href}
              class:list={["nav-item", item.optional && "is-optional"]}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noreferrer" : undefined}
              aria-current={current ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
      <button id="theme-toggle" type="button" class="icon-btn theme-toggle" aria-label="Toggle light and dark mode">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <a href={CLOUD} class="btn small vivid">Try it free</a>
    </nav>
  </div>
</header>

<style>
  .wide-pad { padding: 0 24px; }
</style>

<script>
  // Theme lives in a cookie on .deepdoc.tech so the hosted app at
  // cloud.deepdoc.tech reads the same choice. Omit the domain on localhost or
  // the browser silently drops the cookie.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch {}
    const onProd = location.hostname.endsWith("deepdoc.tech");
    document.cookie =
      "dd_theme=" + next + ";path=/;max-age=31536000;samesite=lax" +
      (onProd ? ";domain=.deepdoc.tech;secure" : "");
    document.dispatchEvent(new CustomEvent("dd-theme", { detail: next }));
  });
</script>
