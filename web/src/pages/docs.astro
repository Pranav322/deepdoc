                  { lang: "JavaScript", exts: ".js, .mjs", frameworks: "Express · Fastify · NestJS (JS mode)", parser: "deepdoc/parser/js_ts_parser.py" },
                  { lang: "TypeScript", exts: ".ts, .tsx", frameworks: "Express · Fastify · NestJS · Next.js API routes", parser: "deepdoc/parser/js_ts_parser.py" },
                  { lang: "Go", exts: ".go", frameworks: "net/http · Gin · Echo (heuristic)", parser: "deepdoc/parser/go_parser.py" },
                  { lang: "PHP", exts: ".php", frameworks: "Laravel (routes/web.php + routes/api.php)", parser: "deepdoc/parser/php_parser.py" },
